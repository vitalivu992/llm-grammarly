{
  "manifest_version": 3,
  "name": "Penwright – LLM writing assistant",
  "short_name": "Penwright",
  "version": "0.1.0",
  "description": "Grammar fixes, tone and formality rewrites in any text field, powered by the LLM you choose.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Penwright",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "options_page": "options/options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/constants.js", "content/diff.js", "content/field.js", "content/styles.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
